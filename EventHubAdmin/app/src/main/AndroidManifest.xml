<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EventHubAdmin">
        <!-- The launcher shows this activity's short label; the toolbar keeps the full name. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/launcher_label"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".AddEditEventActivity"
            android:exported="false"
            android:label="@string/title_add_event"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AddEditSessionActivity"
            android:exported="false"
            android:label="@string/title_add_session"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SessionsActivity"
            android:exported="false"
            android:label="@string/title_sessions" />
        <activity
            android:name=".SessionDetailsActivity"
            android:exported="false"
            android:label="@string/title_session_details" />
        <activity
            android:name=".EventDetailsActivity"
            android:exported="false"
            android:label="@string/title_event_details" />
    </application>

</manifest>