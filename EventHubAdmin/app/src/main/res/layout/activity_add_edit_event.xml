<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AddEditEventActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/description_navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/name_layout"
                style="@style/Widget.EventHubAdmin.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/label_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="@integer/text_max_length" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Starts at two lines and grows as the user types. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/description_layout"
                style="@style/Widget.EventHubAdmin.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:hint="@string/label_description"
                app:counterEnabled="true"
                app:counterMaxLength="@integer/description_max_length"
                app:helperText="@string/helper_optional">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/description_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="@integer/description_max_length"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- No error icon here, so the calendar button stays visible while an error shows. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/date_layout"
                style="@style/Widget.EventHubAdmin.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:hint="@string/label_date"
                app:endIconContentDescription="@string/description_choose_date"
                app:endIconDrawable="@drawable/ic_event"
                app:endIconMode="custom"
                app:errorIconDrawable="@null"
                app:helperText="@string/helper_date_format">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/date_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="@string/digits_date"
                    android:imeOptions="actionNext|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="date"
                    android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- One time range; AddEditEventActivity fills the lists and restores the times. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/start_time_layout"
                    style="@style/Widget.EventHubAdmin.DropdownField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/label_start_time">

                    <com.comp1786.coursework.eventhub.admin.DropdownField
                        android:id="@+id/start_time_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/end_time_layout"
                    style="@style/Widget.EventHubAdmin.DropdownField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_small"
                    android:layout_weight="1"
                    android:hint="@string/label_end_time">

                    <com.comp1786.coursework.eventhub.admin.DropdownField
                        android:id="@+id/end_time_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:saveEnabled="false" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/location_layout"
                style="@style/Widget.EventHubAdmin.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:hint="@string/label_location">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/location_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:maxLength="@integer/text_max_length" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/organizer_layout"
                style="@style/Widget.EventHubAdmin.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:hint="@string/label_organizer">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/organizer_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:maxLength="@integer/text_max_length" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contact_email_layout"
                style="@style/Widget.EventHubAdmin.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:hint="@string/label_contact_email"
                app:helperText="@string/helper_optional">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/contact_email_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionNext|flagNoExtractUi"
                    android:inputType="textEmailAddress"
                    android:maxLength="@integer/email_max_length" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contact_phone_layout"
                style="@style/Widget.EventHubAdmin.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:hint="@string/label_contact_phone"
                app:helperText="@string/helper_optional">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/contact_phone_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="phone"
                    android:digits="@string/digits_phone"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:inputType="phone"
                    android:maxLength="@integer/phone_max_length" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- AddEditEventActivity fills it from EventType and restores the chosen type. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/type_layout"
                style="@style/Widget.EventHubAdmin.DropdownField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:hint="@string/label_type">

                <com.comp1786.coursework.eventhub.admin.DropdownField
                    android:id="@+id/type_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- AddEditEventActivity fills it from EventStatus and starts at Upcoming. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/status_layout"
                style="@style/Widget.EventHubAdmin.DropdownField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:hint="@string/label_status">

                <com.comp1786.coursework.eventhub.admin.DropdownField
                    android:id="@+id/status_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/save_button"
                style="@style/Widget.EventHubAdmin.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_large"
                android:text="@string/button_save_event" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
