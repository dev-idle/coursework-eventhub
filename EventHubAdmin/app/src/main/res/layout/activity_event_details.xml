<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".EventDetailsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/description_navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/title_event_details" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/screen_padding">

            <TextView
                android:id="@+id/event_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Android Dev Summit" />

            <TextView
                android:id="@+id/type_label"
                style="@style/Widget.EventHubAdmin.TypeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/event_name"
                tools:text="@string/type_conference" />

            <TextView
                android:id="@+id/event_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_small"
                android:drawablePadding="@dimen/live_dot_padding"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintBaseline_toBaselineOf="@id/type_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/type_label"
                tools:text="Upcoming in 6 days" />

            <!-- Below the taller label, so a wrapped status never overlaps. -->
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/labels_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="type_label,event_status" />

            <!-- Hidden when the event has no description. -->
            <TextView
                android:id="@+id/event_description"
                style="@style/Widget.EventHubAdmin.DetailValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labels_bottom"
                tools:text="Talks and codelabs on the latest Android tools."
                tools:visibility="visible" />

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/time_divider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/event_description" />

            <!-- The date, then a timeline from start to end, read out as one sentence. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/time_block"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:screenReaderFocusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/time_divider"
                tools:contentDescription="Starts at 19:00 on Saturday 24 October 2026">

                <LinearLayout
                    android:id="@+id/date_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/event_day"
                        style="@style/Widget.EventHubAdmin.DetailDay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        tools:text="24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_medium"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/event_day_of_week"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="Saturday" />

                        <TextView
                            android:id="@+id/event_month"
                            style="@style/Widget.EventHubAdmin.DetailSupporting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            tools:text="October 2026" />
                    </LinearLayout>
                </LinearLayout>

                <!-- The timeline's dots sit in the icon column of the rows below. -->
                <ImageView
                    android:id="@+id/start_dot"
                    android:layout_width="@dimen/detail_icon_size"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/ic_time_start"
                    app:layout_constraintBottom_toBottomOf="@id/start_time"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/start_time" />

                <TextView
                    android:id="@+id/start_label"
                    style="@style/Widget.EventHubAdmin.DetailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/detail_icon_margin"
                    android:layout_marginTop="@dimen/screen_padding"
                    android:importantForAccessibility="no"
                    android:text="@string/label_start_time"
                    app:layout_constraintStart_toEndOf="@id/start_dot"
                    app:layout_constraintTop_toBottomOf="@id/date_row" />

                <TextView
                    android:id="@+id/start_time"
                    style="@style/Widget.EventHubAdmin.DetailTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    app:layout_constraintStart_toStartOf="@id/start_label"
                    app:layout_constraintTop_toBottomOf="@id/start_label"
                    tools:text="19:00" />

                <TextView
                    android:id="@+id/event_length"
                    style="@style/Widget.EventHubAdmin.DetailSupporting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:importantForAccessibility="no"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/start_label"
                    app:layout_constraintTop_toBottomOf="@id/start_time"
                    tools:text="4 hr" />

                <TextView
                    android:id="@+id/end_label"
                    style="@style/Widget.EventHubAdmin.DetailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:importantForAccessibility="no"
                    android:text="@string/label_end_time"
                    app:layout_constraintStart_toStartOf="@id/start_label"
                    app:layout_constraintTop_toBottomOf="@id/event_length" />

                <TextView
                    android:id="@+id/end_time"
                    style="@style/Widget.EventHubAdmin.DetailTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    app:layout_constraintStart_toStartOf="@id/start_label"
                    app:layout_constraintTop_toBottomOf="@id/end_label"
                    tools:text="23:00" />

                <!-- Raised beside the end time, like the +1 on the card. -->
                <TextView
                    android:id="@+id/next_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_tiny"
                    android:importantForAccessibility="no"
                    android:text="@string/next_day_marker"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone"
                    app:layout_constraintStart_toEndOf="@id/end_time"
                    app:layout_constraintTop_toTopOf="@id/end_time"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/end_date"
                    style="@style/Widget.EventHubAdmin.DetailSupporting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/start_label"
                    app:layout_constraintTop_toBottomOf="@id/end_time"
                    tools:text="Sunday 25 October 2026"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/end_dot"
                    android:layout_width="@dimen/detail_icon_size"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/ic_time_end"
                    app:layout_constraintBottom_toBottomOf="@id/end_time"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/end_time" />

                <View
                    android:layout_width="@dimen/timeline_width"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/space_extra_small"
                    android:layout_marginBottom="@dimen/space_extra_small"
                    android:background="?attr/colorOutlineVariant"
                    app:layout_constraintBottom_toTopOf="@id/end_dot"
                    app:layout_constraintEnd_toEndOf="@id/start_dot"
                    app:layout_constraintStart_toStartOf="@id/start_dot"
                    app:layout_constraintTop_toBottomOf="@id/start_dot" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/place_divider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/time_block" />

            <LinearLayout
                android:id="@+id/location_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:screenReaderFocusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/place_divider">

                <ImageView
                    android:layout_width="@dimen/detail_icon_size"
                    android:layout_height="@dimen/detail_icon_size"
                    android:layout_marginTop="@dimen/space_small"
                    android:layout_marginEnd="@dimen/detail_icon_margin"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_place"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.EventHubAdmin.DetailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_location" />

                    <TextView
                        android:id="@+id/event_location"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Greenwich Campus" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/organizer_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:screenReaderFocusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/location_row">

                <ImageView
                    android:layout_width="@dimen/detail_icon_size"
                    android:layout_height="@dimen/detail_icon_size"
                    android:layout_marginTop="@dimen/space_small"
                    android:layout_marginEnd="@dimen/detail_icon_margin"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_person"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.EventHubAdmin.DetailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_organizer" />

                    <TextView
                        android:id="@+id/event_organizer"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Google UK" />
                </LinearLayout>
            </LinearLayout>

            <!-- The contact rows are hidden when empty; tapping one sends an email or calls. -->
            <LinearLayout
                android:id="@+id/contact_email_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:background="?attr/selectableItemBackground"
                android:screenReaderFocusable="true"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/organizer_row"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/detail_icon_size"
                    android:layout_height="@dimen/detail_icon_size"
                    android:layout_marginTop="@dimen/space_small"
                    android:layout_marginEnd="@dimen/detail_icon_margin"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_email"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.EventHubAdmin.DetailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_contact_email" />

                    <TextView
                        android:id="@+id/event_contact_email"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="events@example.com" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contact_phone_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:background="?attr/selectableItemBackground"
                android:screenReaderFocusable="true"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/contact_email_row"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/detail_icon_size"
                    android:layout_height="@dimen/detail_icon_size"
                    android:layout_marginTop="@dimen/space_small"
                    android:layout_marginEnd="@dimen/detail_icon_margin"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_phone"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.EventHubAdmin.DetailLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_contact_phone" />

                    <TextView
                        android:id="@+id/event_contact_phone"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="020 7946 0958" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
