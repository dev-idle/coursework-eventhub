<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".EventDetailsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/description_navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Cards on the header tone, as on the list, so the bar keeps only its buttons. -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_small"
            android:paddingEnd="@dimen/screen_padding">

            <!-- The event, as its card on the list shows it, with every detail. -->
            <LinearLayout
                style="@style/Widget.EventHubAdmin.DetailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_padding"
                    android:paddingTop="@dimen/space_small"
                    android:paddingEnd="@dimen/screen_padding">

                    <TextView
                        android:id="@+id/event_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Android Dev Summit" />

                    <TextView
                        android:id="@+id/type_label"
                        style="@style/Widget.EventHubAdmin.TypeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_small"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/event_name"
                        tools:text="@string/type_conference" />

                    <TextView
                        android:id="@+id/event_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_small"
                        android:drawablePadding="@dimen/live_dot_padding"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:layout_constraintBaseline_toBaselineOf="@id/type_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/type_label"
                        tools:text="Upcoming in 6 days" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/screen_padding"
                    android:layout_marginBottom="@dimen/space_small"
                    app:dividerInsetEnd="@dimen/screen_padding"
                    app:dividerInsetStart="@dimen/screen_padding" />

                <!-- The 18dp icons scale up to 24dp here, which a compound drawable cannot. -->
                <LinearLayout
                    style="@style/Widget.EventHubAdmin.DetailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="@dimen/detail_icon_size"
                        android:layout_height="@dimen/detail_icon_size"
                        android:layout_marginEnd="@dimen/detail_icon_margin"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_event"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/event_date"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Saturday 24 October 2026" />
                </LinearLayout>

                <!-- Read out as one sentence, with the length and any next day. -->
                <LinearLayout
                    android:id="@+id/time_row"
                    style="@style/Widget.EventHubAdmin.DetailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:screenReaderFocusable="true">

                    <ImageView
                        android:layout_width="@dimen/detail_icon_size"
                        android:layout_height="@dimen/detail_icon_size"
                        android:layout_marginEnd="@dimen/detail_icon_margin"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_schedule"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- A raised +1 marks an end on the next day, as on the cards. -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false">

                            <TextView
                                android:id="@+id/event_time"
                                style="@style/Widget.EventHubAdmin.DetailValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"
                                tools:text="19:00–23:00" />

                            <TextView
                                android:id="@+id/next_day"
                                style="@style/Widget.EventHubAdmin.NextDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/event_length"
                            style="@style/Widget.EventHubAdmin.DetailSupporting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            tools:text="4 hr" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.EventHubAdmin.DetailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="@dimen/detail_icon_size"
                        android:layout_height="@dimen/detail_icon_size"
                        android:layout_marginEnd="@dimen/detail_icon_margin"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_place"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/event_location"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Greenwich Campus" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.EventHubAdmin.DetailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="@dimen/detail_icon_size"
                        android:layout_height="@dimen/detail_icon_size"
                        android:layout_marginEnd="@dimen/detail_icon_margin"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_person"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/event_organizer"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Google UK" />
                </LinearLayout>

                <!-- Contact rows are hidden when empty; tapping one sends an email or calls. -->
                <LinearLayout
                    android:id="@+id/contact_email_row"
                    style="@style/Widget.EventHubAdmin.DetailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="@dimen/detail_icon_size"
                        android:layout_height="@dimen/detail_icon_size"
                        android:layout_marginEnd="@dimen/detail_icon_margin"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_email"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/event_contact_email"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="events@example.com" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contact_phone_row"
                    style="@style/Widget.EventHubAdmin.DetailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="@dimen/detail_icon_size"
                        android:layout_height="@dimen/detail_icon_size"
                        android:layout_marginEnd="@dimen/detail_icon_margin"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_phone"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/event_contact_phone"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="020 7946 0958" />
                </LinearLayout>
            </LinearLayout>

            <!-- Opens the event's sessions, and is hidden while an unsaved event is reviewed. -->
            <LinearLayout
                android:id="@+id/sessions_card"
                style="@style/Widget.EventHubAdmin.DetailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="@dimen/detail_card_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding">

                <ImageView
                    android:layout_width="@dimen/detail_icon_size"
                    android:layout_height="@dimen/detail_icon_size"
                    android:layout_marginEnd="@dimen/detail_icon_margin"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_format_list_bulleted"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/session_count"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="4 sessions" />

                    <TextView
                        android:id="@+id/next_session"
                        style="@style/Widget.EventHubAdmin.DetailSupporting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:text="Next: 09:00 Opening keynote"
                        tools:visibility="visible" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/detail_icon_size"
                    android:layout_height="@dimen/detail_icon_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Free text, titled with its field's name, and hidden when it was left empty. -->
            <LinearLayout
                android:id="@+id/description_card"
                style="@style/Widget.EventHubAdmin.DetailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/screen_padding"
                android:screenReaderFocusable="true"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_description"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/event_description"
                    style="@style/Widget.EventHubAdmin.DetailSupporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_extra_small"
                    tools:text="Talks and codelabs on the latest Android tools." />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Shown instead of the menu while an unsaved event is reviewed. -->
    <LinearLayout
        android:id="@+id/review_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/screen_padding"
        android:visibility="gone"
        tools:visibility="visible">

        <Button
            android:id="@+id/edit_button"
            style="@style/Widget.EventHubAdmin.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/button_edit" />

        <Button
            android:id="@+id/confirm_button"
            style="@style/Widget.EventHubAdmin.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_small"
            android:layout_weight="1"
            android:text="@string/button_save_event" />
    </LinearLayout>
</LinearLayout>
