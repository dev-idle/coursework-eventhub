<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SessionDetailsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/description_navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Laid out as the event details screen, card for card. -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_small"
            android:paddingEnd="@dimen/screen_padding">

            <LinearLayout
                style="@style/Widget.EventHubAdmin.DetailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/session_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_padding"
                    android:layout_marginTop="@dimen/space_small"
                    android:layout_marginEnd="@dimen/screen_padding"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Opening keynote" />

                <!-- Gray for every type, as on the session cards. -->
                <TextView
                    android:id="@+id/session_type"
                    style="@style/Widget.EventHubAdmin.TypeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_padding"
                    android:layout_marginTop="@dimen/space_small"
                    android:backgroundTint="@color/type_other_container"
                    tools:text="Keynote" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/screen_padding"
                    android:layout_marginBottom="@dimen/space_small"
                    app:dividerInsetEnd="@dimen/screen_padding"
                    app:dividerInsetStart="@dimen/screen_padding" />

                <!-- The 18dp icons scale up to 24dp here, which a compound drawable cannot. -->
                <LinearLayout
                    style="@style/Widget.EventHubAdmin.DetailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="@dimen/detail_icon_size"
                        android:layout_height="@dimen/detail_icon_size"
                        android:layout_marginEnd="@dimen/detail_icon_margin"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_event"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <!-- The day the session starts on, which is the next one after midnight. -->
                    <TextView
                        android:id="@+id/session_date"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Friday 6 November 2026" />
                </LinearLayout>

                <!-- Read out as one sentence, with the length and any next day. -->
                <LinearLayout
                    android:id="@+id/time_row"
                    style="@style/Widget.EventHubAdmin.DetailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:screenReaderFocusable="true">

                    <ImageView
                        android:layout_width="@dimen/detail_icon_size"
                        android:layout_height="@dimen/detail_icon_size"
                        android:layout_marginEnd="@dimen/detail_icon_margin"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_schedule"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- A raised +1 marks an end on the next day, as on the cards. -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false">

                            <TextView
                                android:id="@+id/session_time"
                                style="@style/Widget.EventHubAdmin.DetailValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"
                                tools:text="09:00–10:00" />

                            <TextView
                                android:id="@+id/next_day"
                                style="@style/Widget.EventHubAdmin.NextDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:importantForAccessibility="no"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/session_length"
                            style="@style/Widget.EventHubAdmin.DetailSupporting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            tools:text="1 hr" />
                    </LinearLayout>
                </LinearLayout>

                <!-- The speaker and room rows are hidden when they were left empty. -->
                <LinearLayout
                    android:id="@+id/speaker_row"
                    style="@style/Widget.EventHubAdmin.DetailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="@dimen/detail_icon_size"
                        android:layout_height="@dimen/detail_icon_size"
                        android:layout_marginEnd="@dimen/detail_icon_margin"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_person"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/session_speaker"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Dr Amy Lee" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/room_row"
                    style="@style/Widget.EventHubAdmin.DetailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="@dimen/detail_icon_size"
                        android:layout_height="@dimen/detail_icon_size"
                        android:layout_marginEnd="@dimen/detail_icon_margin"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_door_front"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/session_room"
                        style="@style/Widget.EventHubAdmin.DetailValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="Painted Hall" />
                </LinearLayout>
            </LinearLayout>

            <!-- Free text, titled with its field's name, and hidden when it was left empty. -->
            <LinearLayout
                android:id="@+id/description_card"
                style="@style/Widget.EventHubAdmin.DetailCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/screen_padding"
                android:screenReaderFocusable="true"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_description"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/session_description"
                    style="@style/Widget.EventHubAdmin.DetailSupporting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_extra_small"
                    tools:text="How mobile apps will change in the next five years." />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
