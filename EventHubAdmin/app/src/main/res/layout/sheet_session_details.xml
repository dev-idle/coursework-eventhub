<?xml version="1.0" encoding="utf-8"?>
<!-- A session in full, with its rows laid out as on the event details screen. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/screen_padding">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/session_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="Opening keynote" />

        <!-- Gray like the session rows, so it reads as a session's type, not an event's. -->
        <TextView
            android:id="@+id/session_type"
            style="@style/Widget.EventHubAdmin.TypeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:backgroundTint="@color/type_other_container"
            tools:text="Keynote" />

        <TextView
            android:id="@+id/session_when"
            style="@style/Widget.EventHubAdmin.DetailSupporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            tools:text="Friday 6 November 2026, 09:00–10:00 (1 hr)" />

        <LinearLayout
            android:id="@+id/speaker_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_padding"
            android:screenReaderFocusable="true">

            <ImageView
                android:layout_width="@dimen/detail_icon_size"
                android:layout_height="@dimen/detail_icon_size"
                android:layout_marginTop="@dimen/space_small"
                android:layout_marginEnd="@dimen/detail_icon_margin"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person"
                app:tint="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.EventHubAdmin.DetailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_speaker" />

                <TextView
                    android:id="@+id/session_speaker"
                    style="@style/Widget.EventHubAdmin.DetailValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Dr Amy Lee" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/room_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_padding"
            android:screenReaderFocusable="true">

            <ImageView
                android:layout_width="@dimen/detail_icon_size"
                android:layout_height="@dimen/detail_icon_size"
                android:layout_marginTop="@dimen/space_small"
                android:layout_marginEnd="@dimen/detail_icon_margin"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_door_front"
                app:tint="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.EventHubAdmin.DetailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_room" />

                <TextView
                    android:id="@+id/session_room"
                    style="@style/Widget.EventHubAdmin.DetailValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Painted Hall" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/session_description"
            style="@style/Widget.EventHubAdmin.DetailValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_padding"
            tools:text="How mobile apps will change in the next five years." />

        <!-- Delete is outlined in red, as it leads to the delete dialog. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:baselineAligned="false">

            <Button
                android:id="@+id/delete_button"
                style="@style/Widget.EventHubAdmin.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/button_delete"
                android:textColor="?attr/colorError" />

            <Button
                android:id="@+id/edit_button"
                style="@style/Widget.EventHubAdmin.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_small"
                android:layout_weight="1"
                android:text="@string/button_edit" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
