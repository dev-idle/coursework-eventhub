    <style name="Theme.EventHubAdmin" parent="Base.Theme.EventHubAdmin">
        <item name="android:datePickerDialogTheme">@style/ThemeOverlay.EventHubAdmin.Picker</item>
        <item name="actionOverflowMenuStyle">@style/Widget.EventHubAdmin.OverflowMenu</item>
        <item name="snackbarStyle">@style/Widget.EventHubAdmin.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.EventHubAdmin.Snackbar.TextView</item>
        <item name="snackbarButtonStyle">@style/Widget.EventHubAdmin.Snackbar.Button</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.EventHubAdmin.BottomSheetDialog</item>
        <!-- The header tone, drawn once through the window; each body is a sheet on top. -->
        <item name="android:windowBackground">@color/list_background</item>
    </style>

    <!-- Drawn behind the navigation bar like the screens, rather than above a black strip. -->
    <style name="ThemeOverlay.EventHubAdmin.BottomSheetDialog"
        parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="enableEdgeToEdge">true</item>
    </style>

</resources>
