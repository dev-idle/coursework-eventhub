<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- The admin app's Material 3 scheme, from seed color #1E6FB8. A key ending in Dark is
         the color for the dark theme. -->
    <Color x:Key="Primary">#455E91</Color>
    <Color x:Key="PrimaryDark">#AEC6FF</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#112F60</Color>
    <Color x:Key="PrimaryContainer">#D8E2FF</Color>
    <Color x:Key="PrimaryContainerDark">#2C4678</Color>
    <Color x:Key="OnPrimaryContainer">#2C4678</Color>
    <Color x:Key="OnPrimaryContainerDark">#D8E2FF</Color>
    <Color x:Key="Error">#A43B33</Color>
    <Color x:Key="ErrorDark">#FFB4AB</Color>
    <Color x:Key="OnSurface">#1A1B20</Color>
    <Color x:Key="OnSurfaceDark">#E2E2E9</Color>
    <Color x:Key="OnSurfaceVariant">#44474F</Color>
    <Color x:Key="OnSurfaceVariantDark">#C5C6D0</Color>
    <Color x:Key="Outline">#75777F</Color>
    <Color x:Key="OutlineDark">#8E9099</Color>
    <Color x:Key="OutlineVariant">#C5C6D0</Color>
    <Color x:Key="OutlineVariantDark">#44474F</Color>
    <Color x:Key="SurfaceContainerHighest">#E2E2E9</Color>
    <Color x:Key="SurfaceContainerHighestDark">#33353A</Color>

    <!-- The screen behind the cards, and the cards, as in the admin app -->
    <Color x:Key="Background">#EEEDF4</Color>
    <Color x:Key="BackgroundDark">#111318</Color>
    <Color x:Key="Card">#FFFFFF</Color>
    <Color x:Key="CardDark">#282A2F</Color>

    <!-- Event type labels -->
    <Color x:Key="TypeConference">#DEECFF</Color>
    <Color x:Key="TypeConferenceDark">#1F4565</Color>
    <Color x:Key="TypeWorkshop">#D4F3D3</Color>
    <Color x:Key="TypeWorkshopDark">#224A2A</Color>
    <Color x:Key="TypeSeminar">#F4E6FF</Color>
    <Color x:Key="TypeSeminarDark">#4C3A65</Color>
    <Color x:Key="TypeSocial">#FFE6D7</Color>
    <Color x:Key="TypeSocialDark">#623812</Color>
    <Color x:Key="TypeOther">#EBEBEE</Color>
    <Color x:Key="TypeOtherDark">#414245</Color>

    <!-- Template colors, still used by Styles.xaml -->
    <Color x:Key="PrimaryDarkText">#112F60</Color>
    <Color x:Key="Secondary">#DBE2F9</Color>
    <Color x:Key="SecondaryDarkText">#C1C6DD</Color>
    <Color x:Key="Tertiary">#2C4678</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
