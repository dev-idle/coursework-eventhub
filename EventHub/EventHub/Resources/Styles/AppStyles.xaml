<?xml version="1.0" encoding="UTF-8" ?>
<!-- The app's own styles, sized as in the admin app. sans-serif-medium is Roboto Medium on Android. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="Count" TargetType="Label">
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <Style x:Key="MonthHeading" TargetType="Label">
        <Setter Property="CharacterSpacing" Value="1.4" />
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="20,16,20,4" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
    </Style>

    <!-- Event cards -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Card}, Dark={StaticResource CardDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <!-- Cut into the card at both ends of the line between the date and the details -->
    <Style x:Key="CardNotch" TargetType="Ellipse">
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="HeightRequest" Value="16" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="WidthRequest" Value="16" />
    </Style>

    <Style x:Key="CardName" TargetType="Label">
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="2" />
    </Style>

    <Style x:Key="TypeLabel" TargetType="Border">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style x:Key="LabelText" TargetType="Label">
        <Setter Property="CharacterSpacing" Value="0.5" />
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="CardTime" TargetType="Label">
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- The dashed line between a card's date or times and its details -->
    <Style x:Key="CardDivider" TargetType="Rectangle">
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}" />
        <Setter Property="StrokeDashArray" Value="4,4" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="WidthRequest" Value="1" />
    </Style>

    <!-- Before "Happening now" -->
    <Style x:Key="LiveDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="HeightRequest" Value="8" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="WidthRequest" Value="8" />
    </Style>

    <!-- Raised after a time on the next day -->
    <Style x:Key="NextDay" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>

    <Style x:Key="CardLine" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}" />
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="CardDetail" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SmallText" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <!-- Empty states, in the middle of the screen -->
    <Style x:Key="EmptyTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="EmptyMessage" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <Style x:Key="TonalButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryContainer}, Dark={StaticResource PrimaryContainerDark}}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="FontFamily" Value="sans-serif-medium" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryContainer}, Dark={StaticResource OnPrimaryContainerDark}}" />
    </Style>
</ResourceDictionary>
